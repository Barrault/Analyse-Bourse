{
  "manifest_version": 3,
  "name": "Analyse boursière — rebalance",
  "version": "1.11.0",
  "description": "Sur « Mes portefeuilles » de Bourse Direct, analyse le compte affiché et montre le plan d'ordres de la stratégie testée. Lecture seule : ne passe aucun ordre.",
  "permissions": ["activeTab", "nativeMessaging", "scripting", "storage"],
  "host_permissions": ["https://*.boursedirect.fr/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://www.boursedirect.fr/*"],
    "js": ["page_account.js", "content.js"],
    "run_at": "document_idle"
  }],
  "action": { "default_popup": "popup.html", "default_title": "Plan de rebalance" }
}
